# 複製成 .env 後填。至少要有一個，多設幾個就會自動當備援。
# start.sh 會自動讀這個檔。
   
GEMINI_API_KEY=
# GROQ_API_KEY=          # 也是語音轉文字的備援（Whisper），建議設
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# 想改順序（預設 gemini → groq → cerebras → mistral → openrouter）
# POKKATOMO_LLM_ORDER=groq,gemini

# 想換模型
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 每一家等幾秒才放棄換下一家（預設 25）
# POKKATOMO_LLM_TIMEOUT=25

# 帳號上限（也可以用 python3 settings.py max_users N）
# POKKATOMO_MAX_USERS=3
